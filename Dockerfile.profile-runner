# syntax=docker/dockerfile:1.7
FROM rust:1.89-trixie AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV LLVM_SYS_191_PREFIX=/usr/lib/llvm-19
ENV MLIR_SYS_190_PREFIX=/usr/lib/llvm-19
ENV TABLEGEN_190_PREFIX=/usr/lib/llvm-19
ENV PATH=/usr/lib/llvm-19/bin:/usr/local/cargo/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates clang-19 git libgmp-dev libmlir-19-dev libpolly-19-dev \
    libssl-dev llvm-19-dev pkg-config python3 python3-dev python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m venv sequencer_venv \
    && sequencer_venv/bin/pip install --upgrade pip

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo fetch --locked

RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    REQS_FILE=$(find /usr/local/cargo/git/checkouts -name requirements.txt -path '*/scripts/*' | head -1) \
    && sequencer_venv/bin/pip install -r "$REQS_FILE"

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/cargo-target \
    --mount=type=cache,target=/cargo-tools \
    . sequencer_venv/bin/activate \
    && find /usr/local/cargo/git/checkouts -path '*/crates/apollo_compilation_utils/src/build_utils.rs' -print0 \
        | xargs -0 perl -0pi -e 's/std::fs::remove_file\(\&binary_path\)\.expect\("Failed to remove the old binary\."\);/let _ = std::fs::remove_file(\&binary_path);/g' \
    && mkdir -p /cargo-target/release/shared_executables \
    && cargo install --locked --root /cargo-tools/starknet-native-compile-0.9.0-rc.6 \
        starknet-native-compile --version 0.9.0-rc.6 \
    && cp /cargo-tools/starknet-native-compile-0.9.0-rc.6/bin/starknet-native-compile \
        /cargo-target/release/shared_executables/starknet-native-compile

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/cargo-target \
    . sequencer_venv/bin/activate \
    && CARGO_TARGET_DIR=/cargo-target cargo build --locked --release --bin generate-pie -j 1 \
    && cp /cargo-target/release/generate-pie /app/generate-pie \
    && cp -R /cargo-target/release/shared_executables /app/shared_executables

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libc6-dev libclang-cpp19 libgmp10 libllvm19 libmlir-19 libssl3 \
    python3 python3-venv time \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 appuser \
    && mkdir -p /app/output \
    && chown -R appuser:appuser /app

COPY --from=builder /app/generate-pie /usr/local/bin/generate-pie
COPY --from=builder /app/shared_executables /cargo-target/release/shared_executables
COPY --from=builder /app/sequencer_venv /app/sequencer_venv

USER appuser
WORKDIR /app

ENV PATH=/app/sequencer_venv/bin:$PATH
ENV RUST_BACKTRACE=1
ENV RUST_LOG=info
ENV SNOS_MAX_PARALLEL_BLOCKS=1

ENTRYPOINT ["/usr/bin/time", "-v", "/usr/local/bin/generate-pie"]
